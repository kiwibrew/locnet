services:
  web-locnet:
    image: locnet:main
    build:
      dockerfile: ./Dockerfile
    restart: always
    container_name: web-locnet
    env_file:
      - .env
    develop:
      watch:
        - action: sync
          path: ./spa/dist
          target: /usr/src/app/spa/dist
          ignore:
            - spa/node_modules/
    ports:
      - "8000:8000"
    volumes:
      - ./cache:/usr/src/app/cache
